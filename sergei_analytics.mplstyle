# Sergei Analytics — matplotlib style (v1). Usage: plt.style.use('sergei_analytics.mplstyle')
font.family: Inter, DejaVu Sans
font.size: 11
text.color: 1a1d2e
axes.titlesize: 14
axes.titleweight: semibold
axes.titlelocation: left
axes.titlepad: 12
axes.labelsize: 11
axes.labelcolor: 6b7280
axes.edgecolor: e5e7eb
axes.linewidth: 1
axes.facecolor: ffffff
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['1a56a0', 'e8913a', '10b981', '2d7dd2', '93c5fd', '6b7280'])
grid.color: e5e7eb
grid.linewidth: 0.8
xtick.color: 6b7280
ytick.color: 6b7280
xtick.major.size: 0
ytick.major.size: 0
legend.frameon: False
legend.fontsize: 10
figure.facecolor: ffffff
figure.dpi: 110
savefig.dpi: 200
savefig.bbox: tight
